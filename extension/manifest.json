{
  "manifest_version": 3,
  "name": "TabWrangler Companion",
  "version": "1.0.15",
  "description": "Companion WebExtension for the TabWrangler Terminal User Interface",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "TabWrangler Companion"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@tabwrangler.local",
      "strict_min_version": "109.0"
    }
  }
}
